# Nota: las API keys de los providers cloud curados se
# configuran desde la UI (Configuración → Providers) y se guardan cifradas
# en la base de datos. No se leen variables de entorno para las keys.

# Modo (dev | prod)
MODE=dev
VITE_MODE=dev

# API URL (para desarrollo y producción)
URL_DEV=http://localhost:8000
URL_PROD=https://tudominio.com
VITE_URL_DEV=http://localhost:8000
VITE_URL_PROD=https://tudominio.com

# Context7 (documentación actualizada, solo creador de tools; funciona sin key con límites menores)
# CONTEXT7_API_KEY=tu_key_de_context7

# Cuentas de mail: se configuran desde la UI (Configuración → Mails) y se
# guardan cifradas en la base de datos. No se usan variables de entorno.

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_token_de_telegram
# Whitelist de chat_ids autorizados (separados por coma). Solo estos pueden usar el bot.
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
