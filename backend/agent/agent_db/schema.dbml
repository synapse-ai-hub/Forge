  total_tokens integer [default: 0, note: 'input + output tokens']
  cost_input real [default: 0.0, note: 'USD cost of the input tokens']
  cost_output real [default: 0.0, note: 'USD cost of the output tokens']
  cost_total real [default: 0.0, note: 'cost_input + cost_output']
  updated_at text [not null, note: 'local time of the last call added']

  indexes {
    (provider, model, month) [name: 'idx_spend_provider_model']
  }

  Note: 'Monthly spend per provider and model: every LLM call adds to the row of its month (llm_process and llm_streaming record it, success or failure).'
}

