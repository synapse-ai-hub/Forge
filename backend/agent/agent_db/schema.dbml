  tool_permissions text [note: 'JSON with the tools the run may use']
  skill_permissions text [note: 'JSON with the skills the run may use']
  parameters text [note: 'JSON with the model parameters of the run']
  last_run_date text [note: 'date of the last execution of the main slot']
  slot_runs text [note: 'JSON map slot -> date of its last execution']
  created_at text [not null, note: 'local time, ISO format']
  updated_at text [not null, note: 'local time of the last edit']

  Note: 'Tasks the scheduler runs on its own: a prompt an agent executes at a time of the day.'
}

Table task_runs {
  id integer [pk, increment, note: 'internal row id; also the run_id of its notification']
  task_id text [not null, note: 'task that ran']
