  indexes {
    started_at [name: 'idx_task_runs_started_at']
    task_id [name: 'idx_task_runs_task_id']
  }

  Note: 'One row per execution of a scheduled task. The session of the run is kept as long as it exists; if it is deleted the run stays without session.'
}

