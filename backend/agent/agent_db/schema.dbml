  indexes {
    kind [name: 'idx_external_usage_kind']
  }

  Note: 'Usage of services other than chat completions, such as the embeddings of a RAG query. The provider column is free text (it can be unknown), so it has no foreign key.'
}

Table creators {
  id integer [pk, increment, note: 'internal row id; orders the rows']
  creator_id text [note: 'conversation the row belongs to (NULL for calls outside a conversation)']
  kind text [not null, note: 'agent | skill | tool | workflow | other']
  role text [not null, note: 'user | assistant | tool | result | call']
  content text [note: 'text of a user or assistant row']
  reasoning text [note: 'reasoning streamed by the creator']
  tool_calls text [note: 'JSON with the arguments of the tool call (tool rows)']
  tool_results text [note: 'JSON with the result of the tool call (tool rows)']
  tool_name text [note: 'tool the creator called (tool rows)']
  status text [note: 'success | error | aborted (result rows)']
  message text [note: 'result or failure message shown to the user (result rows)']
  caller text [note: 'who made the LLM call, e.g. creator:skill:generate (call rows)']
  action text [note: 'question | create | iterate | exists (result rows)']
  item_name text [note: 'name of the item created or modified (result rows)']
  setup text [note: 'JSON with the form of the request: description, name, parameters, ... (first user row)']
  provider text [note: 'provider used']
  model text [note: 'model used']
  prompt_tokens integer [default: 0, note: 'input tokens (call rows)']
  completion_tokens integer [default: 0, note: 'output tokens (call rows)']
  total_tokens integer [default: 0, note: 'input + output tokens (call rows)']
  total_time real [note: 'seconds the call or the request took']
  cost_input real [default: 0.0, note: 'USD cost of the input tokens']
  cost_output real [default: 0.0, note: 'USD cost of the output tokens']
  cost_total real [default: 0.0, note: 'cost_input + cost_output']
  created_at text [not null, note: 'local time, ISO format']

  indexes {
    caller [name: 'idx_creators_caller']
    (kind, created_at) [name: 'idx_creators_kind_created_at']
    creator_id [name: 'idx_creators_creator_id']
  }

  Note: 'Everything the creators (agent, skill, tool and workflow) do, in one table laid out like messages. One creator conversation (creator_id) is a chain of rows: user: what the user wrote in a request (the first one carries setup, the JSON of the form). assistant: text and reasoning the creator streamed. tool: a tool call of the creator with its arguments (tool_calls) and result (tool_results). result: how the request ended (action, item_name, status, message, seconds in total_time). call: one LLM call with its tokens and cost. Calls of the evaluators and the agenda prompt crafter have no conversation (creator_id NULL). spend is not touched here: llm_process already records it. The usage of a request lives in its call rows. The conversations of a creator are listed in its history sidebar and can be reopened to keep modifying what was created. creator_id has no foreign key: no table holds the conversations, they are the group of rows that share it. The provider is free text (it can be unknown).'
}

Table step_frontier {
  id integer [pk, increment, note: 'internal row id']
  session_id text [not null, note: 'session of the turn']
  turn_number integer [not null, note: 'turn the call belongs to']
  step integer [not null, default: 0, note: 'step of the turn']
  substep integer [not null, default: 0, note: 'position inside the step']
  tool_call_id text [note: 'id of the tool call']
  tool_name text [not null, note: 'tool that was called']
  tool_args text [note: 'JSON with the arguments of the call']
  state text [not null, default: `'open'`, note: 'open (dispatched) | done (result committed)']
  child_id text [note: 'session_id of the sub-agent, when the call was a task']
  created_at text [not null, note: 'local time the call was dispatched']
  updated_at text [not null, note: 'local time of the last change']

  indexes {
    (session_id, turn_number) [name: 'idx_step_frontier_session_turn']
  }

  Note: 'Frontier of unsettled work units for the current step. One row per dispatched tool call, written at dispatch time (state \'open\') and flipped to \'done\' when its result commits. Rows are only deleted when the step closes with a validated done signal; a cut flow leaves them behind so the next turn can resume from them.'
}

Table message_feedback {
  id integer [pk, increment, note: 'internal row id']
  session_id text [not null, note: 'session of the answer']
  turn_number integer [not null, note: 'turn of the answer']
  feedback_type text [not null, note: 'up | down']
  model text [note: 'model that produced the answer']
  provider text [note: 'provider of that model']
  created_at text [not null, note: 'local time the feedback was given']
  updated_at text [not null, note: 'local time of the last change']

  indexes {
    created_at [name: 'idx_message_feedback_created_at']
  }

  Note: 'Thumbs up / down the user gives to an assistant answer. One row per answer (a turn of a session); clicking again removes it. model and provider are the ones that produced the answer, so feedback can later be read per model.'
}

Table workflows {
  name text [pk, note: 'workflow name; also the name of its YAML file']
  created_at text [not null, note: 'local time the workflow was registered']
  updated_at text [not null, note: 'local time of the last change']

  Note: 'Registry of workflows. The YAML file stays the definition; the name is the id. A row is created the first time a workflow is saved or run.'
}

Table workflow_runs {
  id integer [pk, increment, note: 'internal row id; orders the rows']
  run_id text [not null, note: 'run the row belongs to; also the id of its session']
  workflow_name text [not null, note: 'workflow that ran']
  kind text [not null, note: 'run | node | decision | judge | output | explain']
  attempt integer [not null, default: 1, note: 'attempt that made the row, 1..3']
  step integer [not null, default: 0, note: 'step of the workflow (0 in the run row)']
  substep integer [not null, default: 0, note: 'position of the row inside its step']
  node_id text [note: 'id of the node in the YAML (node rows)']
  node_type text [note: 'agent | tool | rag | run (node rows)']
  status text [note: 'run: running | success | error | cancelled; node: success | error | cancelled; decision, judge: approved | rejected | error; output, explain: success | error']
  source text [note: 'play | tool (run row)']
  session_id text [note: 'session that holds the execution (run row)']
  parent_session_id text [note: 'session of the agent that called the workflow (run row, source tool)']
  child_session_id text [note: 'session of the sub-agent (agent node rows)']
  result text [note: 'output of the run, of the node or of the call']
  error_text text [note: 'failure message of a node, or plain-language explanation of a failed run']
  provider text [note: 'provider of the model that produced the row']
  model text [note: 'model that produced the row']
  prompt_tokens integer [not null, default: 0, note: 'input tokens']
  completion_tokens integer [not null, default: 0, note: 'output tokens']
  total_tokens integer [not null, default: 0, note: 'prompt_tokens + completion_tokens']
  total_time real [not null, default: 0, note: 'seconds the LLM calls took']
  cost_input real [not null, default: 0, note: 'USD cost of the input tokens']
  cost_output real [not null, default: 0, note: 'USD cost of the output tokens']
  cost_total real [not null, default: 0, note: 'cost_input + cost_output']
  started_at text [not null, note: 'local time the row started']
  finished_at text [note: 'local time the row ended']

  indexes {
    started_at [name: 'idx_workflow_runs_started_at']
    status [name: 'idx_workflow_runs_status']
    workflow_name [name: 'idx_workflow_runs_name']
    run_id [name: 'idx_workflow_runs_one_run', unique]
    (run_id, kind) [name: 'idx_workflow_runs_run']
  }

  Note: 'Everything a workflow run does, in one table laid out like messages. A run is the group of rows that share run_id (also the id of its session), and kind says what each row is: run: the execution itself (source, status, attempt, started_at, finished_at, result, error_text and its sessions). It is the only row of the run that has a result and a source. node: one execution of a node (step, substep, node_id, node_type, status, result or error_text, child_session_id). The nodes of a step run in parallel, each with its own substep. An agent node adds up the spend of its child session. decision: verdict of the decision model on the run. status: approved | rejected; result holds the JSON of its answers. judge: verdict of the chat LLM, used when the decision model is not ready. status: approved | rejected | error; result holds the text it answered. output: the LLM call that writes the output of the run (status: success | error). explain: the LLM call that explains in plain language why a run failed (status: success | error). Rows of a run are never deleted when it ends (workflow_run_steps, in contrast, only keeps what is needed to resume a run and is cleaned when it ends well). The spend of a run is the sum of its rows. spend is NOT touched here: llm_process already records it. status of a run row: running | success | error | cancelled. source: play (UI button) | tool (called by an agent through the workflow tool). attempt: attempt that made the row, 1..3. step / substep: step of the workflow and position inside it (node rows); the rows of the engine take the next step of the run, with substep 0. The sessions are kept while they exist; if one is deleted the row stays without it. run_id has no foreign key: it is the group of rows that share it, so no column is unique to reference.'
}

Table workflow_run_steps {
  id integer [pk, increment, note: 'internal row id']
  run_id text [not null, note: 'run the node belongs to (workflow_runs.run_id)']
  attempt integer [not null, default: 1, note: 'attempt of the run that executed it']
  step integer [not null, note: 'step of the workflow (nodes of the same step run in parallel)']
  substep integer [not null, default: 0, note: 'position of the node inside its step']
  node_id text [not null, note: 'id of the node in the YAML']
  node_type text [not null, note: 'agent | tool | rag | run']
  args text [note: 'JSON with the arguments of the node']
  state text [not null, default: `'open'`, note: 'open | done | failed | stale']
  result text [note: 'complete output of the node']
  error text [note: 'failure message when state is failed']
  child_session_id text [note: 'session of the sub-agent, in agent nodes']
  created_at text [not null, note: 'local time the node was dispatched']
  updated_at text [not null, note: 'local time of the last change']

  indexes {
    (run_id, step) [name: 'idx_workflow_run_steps_run']
  }

  Note: 'Commits of a workflow run: one row per node execution. state: open (dispatched) | done (result committed) | failed | stale (a done row invalidated because an earlier step had to be re-run). result holds the complete node output (never truncated) so a retry or a resume after a crash rebuilds the shared state without re-running it. What ended is deleted: a run that finished well keeps no rows here, only a run that failed or was cut leaves them to resume from. The record of everything the run did lives in workflow_runs. run_id has no foreign key: it is the group of rows of workflow_runs that share it, so no column is unique to reference.'
}

Table notifications {
  id integer [pk, increment, note: 'internal row id']
  kind text [not null, note: 'workflow | task']
  workflow_name text [note: 'workflow that finished (kind workflow)']
  task_id text [note: 'scheduled task that finished (kind task)']
  run_id text [note: 'id of the run in workflow_runs (run_id) or task_runs (id)']
  title text [not null, note: 'workflow or task name shown in the bell']
  status text [not null, note: 'success | error']
  message text [note: 'short text of the result or the failure explanation']
  session_id text [note: 'session of the execution, while it exists']
  read integer [not null, default: 0, note: '0 unread, 1 read']
  created_at text [not null, note: 'local time, ISO format']

  indexes {
    created_at [name: 'idx_notifications_created_at']
    read [name: 'idx_notifications_read']
  }

  Note: 'Notifications of finished workflow runs and scheduled-task executions. Exactly one of workflow_name / task_id is set (FK to the PK of each table). run_id: workflow_runs.run_id or task_runs.id (as text) to open the detail; it has no foreign key because it points to one table or the other depending on kind. status: success | error. read: 0 unread, 1 read.'
}

