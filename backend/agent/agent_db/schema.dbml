// Generated by generate_schema_docs.py from the real schema. Do not edit by hand.

Table sessions {
  id integer [pk, increment, note: 'internal row id']
  session_id text [not null, unique, note: 'public id of the session (the one the API and the other tables use)']
  created_at text [not null, note: 'local time, ISO format']
  updated_at text [not null, note: 'local time of the last message; orders the sidebar']
  metadata text [note: 'JSON object with free data of the origin, e.g. {"source": "workflow"} (workflow, scheduler, review)']
  title text [note: 'title shown in the sidebar']
  parent_id text [note: 'session_id of the parent session (NULL for root sessions)']

  indexes {
    parent_id [name: 'idx_sessions_parent_id']
  }

  Note: 'Chat sessions. A root session is a conversation shown in the sidebar; a child session (parent_id set) belongs to a sub-agent called with task or to a node of a workflow run. Deleting a session deletes its children and everything that hangs from it.'
}

Table messages {
  id integer [pk, increment, note: 'internal row id; orders the messages']
  session_id text [not null, note: 'session the message belongs to']
  role text [not null, note: 'system | user | assistant | tool | title | decisor (verdict of the decision model)']
  content text [note: 'text of the message']
  reasoning text [note: 'reasoning of the model, when it produced one']
  tool_calls text [note: 'JSON list of the tool calls the assistant requested']
  tool_results text [note: 'JSON list of the results of those calls']
  status text [note: 'success | error, for assistant messages']
  message text [note: 'plain description of the error when status is error']
  prompt_tokens integer [note: 'input tokens of the LLM call']
  completion_tokens integer [note: 'output tokens of the LLM call']
  total_tokens integer [note: 'prompt_tokens + completion_tokens']
  total_time real [note: 'seconds the call took']
  time_to_first_token real [note: 'seconds until the first token arrived']
  tool_call_id text [note: 'id of the tool call, in tool messages']
  tool_name text [note: 'name of the tool, in tool messages']
  model text [note: 'model that produced the message']
  provider text [note: 'provider of that model']
  cost_input real [note: 'USD cost of the input tokens']
  cost_output real [note: 'USD cost of the output tokens']
  cost_total real [note: 'cost_input + cost_output']
  turn_number integer [note: 'turn of the session (1, 2, ...)']
  step integer [default: 0, note: 'step inside the turn (one per LLM round)']
  substep integer [default: 0, note: 'position inside the step (parallel tool calls)']
  created_at text [not null, note: 'local time, ISO format']

  indexes {
    session_id [name: 'idx_messages_session_id']
  }

  Note: 'Every message of every session: what the user wrote, what the model answered, the tool results and the verdicts of the decision model. One row per message, with the tokens, time and cost of the LLM call that produced it. A turn is one user message and all the steps the agent takes to answer it.'
}

Table turn_latency {
  id integer [pk, increment, note: 'internal row id']
  session_id text [not null, note: 'session of the turn']
  turn_number integer [not null, note: 'turn of the session']
  latency real [note: 'seconds of the whole turn']

  indexes {
    (session_id, turn_number) [name: 'idx_turn_latency_session_turn']
  }

  Note: 'Seconds each turn took from the user message to the final answer.'
}

Table config_kv {
  key text [pk, note: 'name of the setting']
  value text [note: 'value of the setting, as text']

  Note: 'Key/value store of application settings persisted in the database (for example the global advanced-parameter overrides and the last sync of each model catalog).'
}

Table providers {
  provider text [pk, note: 'provider id, e.g. google']
  label text [not null, note: 'name shown to the user']
  models text [note: 'JSON list of the model ids the provider offers']
  updated_at text [not null, note: 'local time of the last refresh']

  Note: 'Cache of the LLM providers the application offers (google, openrouter, groq, LOCAL, ...). Rows are upserted, never deleted. Most tables that hold a provider name point here.'
}

Table provider_api_keys {
  provider text [pk, note: 'provider the key belongs to']
  api_key_encrypted text [not null, note: 'encrypted API key']
  updated_at text [not null, note: 'local time the key was saved']

  Note: 'API key of each provider, stored encrypted. One row per provider.'
}

Table error_log {
  id integer [pk, increment, note: 'internal row id']
  session_id text [note: 'session that was running, when there was one']
  parent_id text [note: 'parent session of that session']
  turn_number integer [note: 'turn that was running']
  exception text [not null, note: 'error message']
  source text [note: 'where it was caught (file:function)']
  created_at text [not null, note: 'local time, ISO format']

  indexes {
    created_at [name: 'idx_error_log_created_at']
    session_id [name: 'idx_error_log_session_id']
  }

  Note: 'Errors the application caught, with the session and turn that were running. It has no foreign key on purpose: an error must be stored even when its session does not exist (anymore) and it must outlive the session.'
}

Table context_files {
  id integer [pk, increment, note: 'internal row id']
  filename text [not null, note: 'original file name']
  content text [not null, note: 'text of the file']
  created_at text [not null, note: 'local time the file was loaded']

  Note: 'Files the user loads as global context. Their content is added to the system prompt of every conversation.'
}

Table attachments {
  id integer [pk, increment, note: 'internal row id']
  session_id text [not null, note: 'session of the message']
  turn_number integer [not null, note: 'turn the file was attached to']
  file_name text [not null, note: 'original file name']
  size integer [note: 'size in bytes']
  content blob [note: 'bytes of the file']
  created_at text [not null, note: 'local time, ISO format']

  indexes {
    (session_id, turn_number) [name: 'idx_attachments_session_turn']
  }

  Note: 'Files the user attaches to a message. Deleted with the session.'
}

Table scheduled_tasks {
  id text [pk, note: 'task id']
  name text [not null, note: 'name shown to the user']
  prompt text [not null, note: 'what the agent has to do']
